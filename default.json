{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",

  "description": "Shared Renovate configuration for Gerard's projects",

  "extends": [
    "config:recommended",
    ":dependencyDashboard"
  ],

  "timezone": "Europe/Amsterdam",

  "schedule": [
    "before 6am on Monday"
  ],

  "labels": [
    "dependencies"
  ],

  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,

  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 6am on Monday"
    ]
  },

  "packageRules": [
    {
      "description": "Group patch dependency updates",
      "matchUpdateTypes": [
        "patch"
      ],
      "groupName": "patch dependency updates"
    },
    {
      "description": "Group minor dependency updates",
      "matchUpdateTypes": [
        "minor"
      ],
      "groupName": "minor dependency updates"
    },
    {
      "description": "Require dashboard approval for major updates",
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true
    }
  ],

  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": [
      "security"
    ]
  }
}
